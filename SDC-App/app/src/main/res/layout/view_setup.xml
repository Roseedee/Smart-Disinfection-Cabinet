<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setupView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_setup"
        tools:context=".StartupActivity">

        <ImageView
            android:id="@+id/microwaveImage"
            android:layout_width="202dp"
            android:layout_height="173dp"
            android:scaleType="fitCenter"
            android:src="@drawable/microwave"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/guideline50" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.50" />

        <LinearLayout
            android:id="@+id/setupSheet"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:paddingStart="35dp"
            android:paddingTop="34dp"
            android:paddingEnd="35dp"
            app:layout_constraintTop_toTopOf="@+id/guideline50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/setupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ตั้งค่าการใช้งาน"
                android:textColor="@android:color/black"
                android:fontFamily="@font/kanit"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setupSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="สามารถใส่รหัสเครื่องเฉพาะที่เครื่องออนไลน์แล้วเท่านั้น"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/kanit"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/fullNameInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_setup_input"
                android:hint="ชื่อ-นามสกุล"
                android:inputType="textPersonName"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@android:color/black"
                android:textColorHint="@color/text_hint"
                android:fontFamily="@font/kanit"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/deviceCodeInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_setup_input"
                android:hint="รหัสประจำตัวเครื่อง"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="@android:color/black"
                android:textColorHint="@color/text_hint"
                android:fontFamily="@font/kanit"
                android:textSize="14sp" />

            <!-- ปุ่มเข้าสู่ระบบ -->

            <TextView
                android:id="@+id/registerButton"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_connect_button"
                android:gravity="center"
                android:text="เข้าสู่ระบบ"
                android:textColor="@android:color/white"
                android:fontFamily="@font/kanit"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- ปุ่มค้นหาอุปกรณ์ -->

            <TextView
                android:id="@+id/findDeviceButton"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_find_button"
                android:gravity="center"
                android:text="ค้นหาอุปกรณ์"
                android:textColor="@android:color/white"
                android:fontFamily="@font/kanit"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/connectionHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="วิธีการเชื่อมต่ออุปกรณ์"
                android:textColor="@android:color/black"
                android:fontFamily="@font/kanit"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>