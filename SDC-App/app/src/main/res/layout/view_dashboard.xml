            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_panel"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <TextView
                        android:background="@drawable/bg_dashboard_header"
                        android:textAlignment="center"
                        android:paddingVertical="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_semibold"
                        android:text="อุคลหภูมิ"
                        android:textColor="@color/text_header"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="27dp"
                        android:layout_marginTop="5dp"
                        android:paddingHorizontal="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="22dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/currentTemperatureText"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:fontFamily="@font/kanit"
                                android:text="ปัจจุบัน 0°C"
                                android:textColor="@android:color/black"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:fontFamily="@font/kanit"
                                android:text="100°C"
                                android:textColor="@android:color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/temperatureProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:max="100"
                            android:progress="50"
                            android:progressBackgroundTint="@color/progress_track"
                            android:progressTint="@color/bg_progress" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_panel"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <TextView
                        android:background="@drawable/bg_dashboard_header"
                        android:textAlignment="center"
                        android:paddingVertical="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_semibold"
                        android:text="ความชื้น"
                        android:textColor="@color/text_header"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="27dp"
                        android:layout_marginTop="5dp"
                        android:paddingHorizontal="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="22dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/currentHumidityText"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:fontFamily="@font/kanit"
                                android:text="ปัจจุบัน 0%"
                                android:textColor="@android:color/black"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:fontFamily="@font/kanit"
                                android:text="100%"
                                android:textColor="@android:color/black"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/humidityProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:max="100"
                            android:progress="50"
                            android:progressBackgroundTint="@color/progress_track"
                            android:progressTint="@color/bg_progress" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_dashboard_panel"
                    android:orientation="vertical">

                    <TextView
                        android:background="@drawable/bg_dashboard_header"
                        android:textAlignment="center"
                        android:paddingVertical="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_semibold"
                        android:text="สถานะประตู"
                        android:textColor="@color/text_header"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/doorSWStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:fontFamily="@font/kanit_semibold"
                            android:text="ปิดอยู่"
                            android:textColor="@android:color/black"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingBottom="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dashboard_panel"
                    android:orientation="vertical">

                    <TextView
                        android:background="@drawable/bg_dashboard_header"
                        android:textAlignment="center"
                        android:paddingVertical="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_semibold"
                        android:text="สถานะมอเตอร์"
                        android:textColor="@color/text_header"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/motorStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:fontFamily="@font/kanit_semibold"
                            android:text="ปิดอยู่"
                            android:textColor="@android:color/black"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_dashboard_panel"
                    android:orientation="vertical">

                    <TextView
                        android:background="@drawable/bg_dashboard_header"
                        android:textAlignment="center"
                        android:paddingVertical="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/kanit_semibold"
                        android:text="การอ่านค่าของ UV"
                        android:textColor="@color/text_header"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/uvSensorText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:fontFamily="@font/kanit_semibold"
                            android:text="0mW/cm²"
                            android:textColor="@android:color/black"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_dashboard_panel"
